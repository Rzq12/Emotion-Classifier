# ---------------------------------------------------------------------------
# Backend environment variables (copy ke `.env`, jangan pernah commit `.env`)
# ---------------------------------------------------------------------------

# --- LLM provider (Fase 3+) ---
# Pilih salah satu: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq (cepat, ada free tier) — ambil key di https://console.groq.com/keys
# Satu key: pakai GROQ_API_KEY. Beberapa key (rotasi otomatis saat rate limit):
# pakai GROQ_API_KEYS (dipisah koma) ATAU GROQ_API_KEY_1..GROQ_API_KEY_N.
# Prioritas: GROQ_API_KEYS > GROQ_API_KEY_<n> > GROQ_API_KEY.
GROQ_API_KEY=
GROQ_API_KEYS=
# Default di kode: qwen/qwen3.8-27b. Model ini berstatus *preview* di Groq
# (bisa dicabut lebih cepat, rate limit free tier ketat). Cek daftar terbaru di
# https://console.groq.com/docs/models dan ganti ke model production jika perlu.
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini — ambil key di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (lokal, gratis, untuk development offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- RAG (Fase 3+) ---
# Path ChromaDB, model embedding, top_k, dan threshold diatur di file ini.
RAG_CONFIG=configs/rag.yaml

# --- API (Fase 4+) ---
# Port fixed 7860 (requirement HF Spaces), di-set di Dockerfile.
CORS_ALLOW_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10

# --- Monitoring (Fase 6) ---
# Log prediksi /classify (JSONL) — input untuk src/monitoring/check_drift.py
PREDICTION_LOG_PATH=data/monitoring/predictions.jsonl
# Data referensi untuk status drift di GET /monitoring/summary (kolom text,label)
DRIFT_REFERENCE_CSV=data/processed/train.csv

# --- MLflow tracking (Fase 2+) ---
# DB backend (sqlite) diperlukan untuk fitur terbaru + model registry.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Model artifact (Fase 4+) ---
# Classifier IndoBERT: path lokal ATAU repo id HF Hub (mis. user/indo-emotion-indobert).
MODEL_DIR=artifacts/indobert
# Hanya untuk scripts/push_model_to_hub.py (upload model ke HF Hub).
HF_TOKEN=

# --- Agentic layer (Fase 6) ---
# Konfigurasi graph, threshold router, dan path queue db.
AGENT_CONFIG=configs/agent.yaml
# SQLite antrean tiket agent (dibuat otomatis kalau belum ada).
AGENT_QUEUE_DB=agent_queue.db
# Notifikasi eskalasi via Telegram bot. Kosongkan keduanya -> fallback log file.
# Buat bot lewat @BotFather, ambil chat_id dari getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Wajib untuk aksi reviewer: POST /agent/approve, /agent/reject, GET /agent/notify-test
# (kirim lewat header X-API-Key). Kosong = endpoint itu mengembalikan 503 (fail-closed).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
